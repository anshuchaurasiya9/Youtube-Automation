# YouTube Automation Environment Configuration
# Add your Pollinations.ai API / Pollen key here (optional, works free without key too):
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Voiceover playback rate (e.g. +65% for 1.65x speed):
VOICE_RATE=+65%

